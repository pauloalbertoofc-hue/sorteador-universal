{
  "name": "sorteador-universal",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sorteador-universal-db",
      "database_id": "24fe67dc-7003-4557-9de0-cf6658e713c2"
    }
  ],
  "$schema": "node_modules/wrangler/config-schema.json",
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "sorteador-universal-preview-db",
        "database_id": "9701cfcf-9c77-4b09-8411-0f4a13f8c584",
        "migrations_dir": "migrations/preview"
      }
    ],
    "vars": {
      "BILLING_ENABLED": "false"
    }
  },
  "triggers": {"crons": ["17 3 * * *"]},
  "keep_vars": true
}
